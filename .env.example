# Copy this file to `.env` and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API -> "Project URL" and "anon public" key.
#
# These are safe to expose in the browser bundle: the anon key is the public key.
# The app only uses Supabase Realtime (Broadcast + Presence), so no database
# tables, SQL or Row Level Security setup is required.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
